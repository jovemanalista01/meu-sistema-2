# Modo do Banco de Dados: 'sqlite' (padrão de transição) ou 'firestore'
DB_BACKEND=sqlite

# Caminho para arquivo SQLite local
SQLITE_DB_PATH=../escala.db

# Configurações do Firebase (Backend)
# Caminho para o JSON da chave da conta de serviço baixado do Firebase Console
FIREBASE_CREDENTIALS_PATH=../config/firebase_credentials.json

# Autenticação Backend:
# Se 'true', valida token JWT Bearer do Firebase Auth
# Se 'false', permite modo desenvolvimento local sem checagem de token
AUTH_REQUIRED=false

# Porta do servidor Flask
PORT=5000
HOST=0.0.0.0
